# =============================
# PartHub — local development
# =============================
# Front-end apps: Vite reads VITE_* from each app's OWN folder, so put
# these lines in apps/storefront/.env.local, apps/seller-portal/.env.local
# and apps/admin/.env.local (git-ignored). Without them the apps call the
# production API (https://api.parthub.autos).
VITE_API_BASE_URL=http://localhost:8787
VITE_SELLER_API_BASE_URL=http://localhost:8787
VITE_ADMIN_API_BASE_URL=http://localhost:8787
VITE_SELLER_PORTAL_URL=http://localhost:3001

# Remote D1 scripts in scripts/ (seeding, checks) only.
CF_ACCOUNT_ID=your-cloudflare-account-id

# The API's secrets do NOT go here: for `wrangler dev` put them in
# workers/api/.dev.vars (git-ignored), e.g.
#   JWT_SECRET=a-long-random-string-for-local-only
# In production they are Worker secrets (see README › Configuration).
